# Copy to .env.local and fill in real values. Never commit .env.local.

# Public app URL, safe to expose to the browser. Leave unset in production —
# src/lib/site-url.ts resolves it automatically from Vercel's environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Ads tag ID (Google Ads > Tools > Conversions > "Google tag" card).
# Leave empty to disable Google Ads/consent scripts entirely (e.g. in dev).
NEXT_PUBLIC_GOOGLE_ADS_ID=
